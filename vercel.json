{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "echo 'control-plane: no frontend build'",
  "outputDirectory": "public",
  "rewrites": {
    "beforeFiles": [
      { "source": "/", "destination": "/api" },
      { "source": "/index.html", "destination": "/api" }
    ],
    "afterFiles": [
      { "source": "/(.*)", "destination": "/api" }
    ]
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 10,
      "memory": 1024,
      "includeFiles": "{public/**,src/**,package.json}"
    }
  }
}

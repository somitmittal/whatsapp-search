{
  "name": "whatsapp-search-agent",
  "version": "1.0.0",
  "description": "WhatsApp Search Agent - search all your chats using AI, 100% locally",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "electron": "electron .",
    "preelectron": "bash scripts/generate-icon-icns.sh",
    "dist:mac": "bash scripts/generate-icon-icns.sh && bash scripts/prepare-node-mac.sh && electron-builder install-app-deps && electron-builder --mac",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "qa:search": "node scripts/search-qa-agent.mjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.7.0",
    "cookie": "^0.7.1",
    "cookie-parser": "^1.4.7",
    "expo": "^55.0.17",
    "express": "^5.2.1",
    "fuse.js": "^7.3.0",
    "googleapis": "^144.0.0",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.6",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.whatsappsearch.desktop",
    "productName": "WhatsApp Search",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "build/node",
        "to": "node",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "WhatsApp Search"
    }
  }
}

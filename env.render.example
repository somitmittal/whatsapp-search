# =============================================================================
# Render.com — copy these into Dashboard → Environment (or paste as bulk)
# Do NOT commit real secrets. Use Render "Secret" type for keys.
# Render injects: RENDER, RENDER_EXTERNAL_URL, PORT — you normally do not set those.
# =============================================================================

# --- Required on Render (app will not start without this on public URL) ---
# Long random **server** string (not a "JWT" you type in the app), e.g. openssl rand -hex 32
# Either name works:
SESSION_SECRET=replace-with-long-random-secret
# JWT_SECRET=replace-with-long-random-secret

# --- LLM keys (defaults on Render: Groq search + Ollama Cloud summaries) ---
# At least one search key is needed for AI search to work without pasting in UI.
GROQ_API_KEY=
# Optional privacy-focused EU provider (Settings → Munito). Zero retention by default.
# MUNITO_API_KEY=
# Optional override (default: https://api.eu.munito.ai/inference/v1):
# MUNITO_BASE_URL=https://api.eu.munito.ai/inference/v1
# LLM_PROVIDER=munito
# LLM_MODEL=qwen/qwen3.8-27b
# Optional alias for search key:
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# Local Ollama is NOT supported on Render (no binary, ~512 MB RAM). Keep this false:
OLLAMA_AUTO_START=false

# Summaries (default provider ollama_cloud / gpt-oss:20b)
OLLAMA_CLOUD_API_KEY=

# Media search indexing — Gemini 2.5 Flash default (vision + audio transcription for FTS on images/video/voice)
# One key, or several (comma / newline / multiple env vars — merged for rotation):
# GEMINI_API_KEY=key1,key2,key3
# GEMINI_API_KEYS=key4
# GEMINI_API_KEY_1=…   GEMINI_API_KEY_2=…   (up to _24 — useful on Render when each secret is one key)
# MEDIA_INDEX_API_KEY=…   MEDIA_INDEX_API_KEYS=…
# Optional overrides: MEDIA_INDEX_PROVIDER=gemini  MEDIA_INDEX_MODEL=gemini-2.5-flash
# Optional alias:
# SUMMARY_API_KEY=

# Optional: custom Ollama Cloud API base (default is ollama.com cloud)
# OLLAMA_CLOUD_URL=https://ollama.com

# Optional model overrides (defaults in config.js)
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=llama-3.3-70b-versatile
# SUMMARY_MODEL=gpt-oss:20b

# Optional: GitHub repo for /download page (default somitmittal/whatsapp-search)
# GITHUB_REPO=somitmittal/whatsapp-search

# Recommended on Render — avoids GitHub API 403 rate limits (shared egress IP).
# Create a fine-grained PAT with read-only access to this repo's metadata/contents.
# GITHUB_TOKEN=github_pat_...

# Optional: cache TTL for /api/releases/latest (default 1 hour — matches GitHub unauthenticated budget)
# GITHUB_RELEASES_CACHE_MS=3600000
# PUBLIC_WEB_URL=https://your-service.onrender.com

# --- Control plane (accounts, licenses, download analytics, Stripe) ---
# Public URL used in magic-link emails (defaults to RENDER_EXTERNAL_URL):
# CONTROL_PLANE_PUBLIC_URL=https://your-service.onrender.com
# Optional separate SQLite path (default: $DATA_DIR/control_plane.db):
# CONTROL_PLANE_DB=/var/data/control_plane.db
# LICENSE_GATE=1
# LICENSE_GATE_STRICT=0
# Magic-link email via Resend (without this, codes are logged + returned to the app):
# RESEND_API_KEY=
# CONTROL_PLANE_FROM_EMAIL=Searchable <onboarding@yourdomain.com>
# Stripe (Pro subscription):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PostHog product analytics (optional):
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Desktop builds should set CONTROL_PLANE_URL to this same public URL.

# Optional: `FORCE_SECURE_COOKIES=true` to set Secure on session cookies in non-Render dev (HTTPS).
# DEFAULT_TENANT_ID=legacy-default  (only when SESSION_SECRET/JWT_SECRET unset — local single-tenant)

# --- Optional: Gmail "Sync from Gmail" for exports ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Exact redirect in Google Cloud Console, e.g.:
# GOOGLE_REDIRECT_URI=https://your-service.onrender.com/api/gmail/oauth/callback
# Extra allowed browser origins (comma-separated), if using custom domain:
# GOOGLE_OAUTH_PUBLIC_ORIGINS=https://custom.example.com

# --- Optional: data directory (ONLY with a Render Disk) ---
# Do NOT set DATA_DIR=/var/data unless you created a Disk with Mount Path = /var/data.
# Otherwise deploy crashes with: EACCES mkdir '/var/data'
# Without a disk: leave DATA_DIR unset (uses ./data; wiped on each deploy).
# With a disk:
#   Render → Disks → New → Mount Path: /var/data
#   DATA_DIR=/var/data
#   CONTROL_PLANE_DB=/var/data/control_plane.db

# --- Optional: summary tuning ---
# SUMMARY_CONCURRENCY=2
# SUMMARY_BATCH_DELAY_MS=500

# Max messages per /api/messages response (default 10000, clamped 500–50000). Raises UI depth for long histories.
# MAX_MESSAGES_PAGE=10000

# --- Linked device: fewer “syncing” notifications on your phone ---
# false = ask Baileys for less automatic history on connect (lighter sync; use export / “fetch older” for depth)
# WA_SYNC_FULL_HISTORY=false
# default off — was causing extra resyncAppState right after every connect. Use Settings → refresh contact names when needed.
# WA_AUTO_APP_STATE_RESYNC=1

# --- Host (Render usually does not need this) ---
# HOST=0.0.0.0
# Web port: Render sets PORT automatically — do not set WEB_PORT in production.

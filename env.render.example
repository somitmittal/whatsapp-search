# =============================================================================
# Render.com — copy these into Dashboard → Environment (or paste as bulk)
# Do NOT commit real secrets. Use Render "Secret" type for keys.
# Render injects: RENDER, RENDER_EXTERNAL_URL, PORT — you normally do not set those.
# =============================================================================

# --- Required on Render (app will not start without this on public URL) ---
# Long random **server** string (not a "JWT" you type in the app), e.g. openssl rand -hex 32
# Either name works:
SESSION_SECRET=replace-with-long-random-secret
# JWT_SECRET=replace-with-long-random-secret

# --- LLM keys (defaults: Groq search + Ollama Cloud summaries) ---
# At least one search key is needed for AI search to work without pasting in UI.
GROQ_API_KEY=
# Optional alias for search key:
# LLM_API_KEY=

# Summaries (default provider ollama_cloud / gpt-oss:20b)
OLLAMA_CLOUD_API_KEY=
# Optional alias:
# SUMMARY_API_KEY=

# Optional: custom Ollama Cloud API base (default is ollama.com cloud)
# OLLAMA_CLOUD_URL=https://ollama.com

# Optional model overrides (defaults in config.js)
# GROQ_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=llama-3.3-70b-versatile
# SUMMARY_MODEL=gpt-oss:20b

# --- Public URL (Render sets RENDER_EXTERNAL_URL; this is an extra override if needed) ---
# PUBLIC_WEB_URL=https://your-service.onrender.com

# Optional: `FORCE_SECURE_COOKIES=true` to set Secure on session cookies in non-Render dev (HTTPS).
# DEFAULT_TENANT_ID=legacy-default  (only when SESSION_SECRET/JWT_SECRET unset — local single-tenant)

# --- Optional: Gmail "Sync from Gmail" for exports ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Exact redirect in Google Cloud Console, e.g.:
# GOOGLE_REDIRECT_URI=https://your-service.onrender.com/api/gmail/oauth/callback
# Extra allowed browser origins (comma-separated), if using custom domain:
# GOOGLE_OAUTH_PUBLIC_ORIGINS=https://custom.example.com

# --- Optional: data directory (use with Render Disk mount) ---
# If you add a persistent disk mounted at /var/data:
# DATA_DIR=/var/data

# --- Optional: summary tuning ---
# SUMMARY_CONCURRENCY=2
# SUMMARY_BATCH_DELAY_MS=500

# Max messages per /api/messages response (default 10000, clamped 500–50000). Raises UI depth for long histories.
# MAX_MESSAGES_PAGE=10000

# --- Host (Render usually does not need this) ---
# HOST=0.0.0.0
# Web port: Render sets PORT automatically — do not set WEB_PORT in production.

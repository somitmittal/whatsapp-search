# Vercel project → Settings → Environment Variables
# Deploy: npx vercel --prod  (CONTROL_PLANE_ONLY control plane + Turso + Resend)

CONTROL_PLANE_ONLY=1
SESSION_SECRET=

# After first deploy, set to your production URL (also used in magic-link emails):
# CONTROL_PLANE_PUBLIC_URL=https://your-project.vercel.app
# Or custom domain:
# CONTROL_PLANE_PUBLIC_URL=https://accounts.searchable.app

# Turso (required on Vercel — no durable local disk)
TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
TURSO_AUTH_TOKEN=

# Resend (required on public hosts — OTP never returned in JSON)
RESEND_API_KEY=
CONTROL_PLANE_FROM_EMAIL=Searchable <onboarding@yourdomain.com>

# Admin /analytics HTTP Basic
CONTROL_PLANE_ADMIN_USER=admin
CONTROL_PLANE_ADMIN_PASSWORD=

LICENSE_GATE=1
# APP_MIN_VERSION=1.0.13
# APP_UPDATE_DOWNLOAD_URL=https://your-project.vercel.app/download

# Stripe (optional)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# Desktop releases: GitHub Actions secret CONTROL_PLANE_URL = same as CONTROL_PLANE_PUBLIC_URL

# =============================================================================
# Minimum to *start* the Node process on Render (public URL).
# Render also injects: PORT, RENDER, RENDER_EXTERNAL_URL — do not set those here.
# Local dev: optional (single-tenant legacy mode) — still recommended.
# Render/public: REQUIRED — a long random server secret (SESSION_SECRET or JWT_SECRET) for
# per-browser sessions and data isolation. Not a user "login" token.
# =============================================================================
SESSION_SECRET=

# =============================================================================
# Not required for the process to boot, but required for default AI search + summaries
# without pasting keys in the UI (set in Render as Secrets):
# GROQ_API_KEY=
# OLLAMA_CLOUD_API_KEY=
# Optional — Gemini for media FTS (multiple keys: GEMINI_API_KEY=key1,key2 or GEMINI_API_KEY_1 / _2 …)
# GEMINI_API_KEY=
# =============================================================================

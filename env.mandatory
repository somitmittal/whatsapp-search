# =============================================================================
# Minimum to *start* the Node process on Render (public URL).
# Render also injects: PORT, RENDER, RENDER_EXTERNAL_URL — do not set those here.
# Local dev: JWT_SECRET optional (legacy mode), but recommended.
# Render/public: JWT_SECRET is REQUIRED so each user logs in and sees only their own data.
# =============================================================================
JWT_SECRET=

# =============================================================================
# Not required for the process to boot, but required for default AI search + summaries
# without pasting keys in the UI (set in Render as Secrets):
# GROQ_API_KEY=
# OLLAMA_CLOUD_API_KEY=
# =============================================================================
